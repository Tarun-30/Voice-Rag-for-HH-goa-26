# ============================================================================
#  Voice RAG (Goa Hacker House) - backend configuration
#  Copy to `.env` and fill in what you have. EVERY KEY IS OPTIONAL.
#
#  With no keys at all the system still runs end to end: retrieval is fully
#  local, and the harness falls back to a deterministic extractive answerer.
#  You just lose spoken input and generative phrasing. Type a question in the
#  UI instead of speaking it and every latency number below is still real.
# ============================================================================

# ---------------------------------------------------------------------------- #
#  LLM  (generation)  - pick ONE, Groq is the fastest to first token
# ---------------------------------------------------------------------------- #
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# NOTE ON MODEL IDS - READ THIS BEFORE CHANGING THEM
# Groq decommissioned `llama-3.1-8b-instant` and `llama-3.3-70b-versatile` on
# 2026-08-16. Any tutorial or spec naming those will fail with a 404
# model_not_found. The defaults below are live as of 2026-08-22.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Optional second provider. The harness fails over to it when Groq's circuit
# breaker opens. https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

LLM_TEMPERATURE=0.15
LLM_MAX_TOKENS=420
LLM_TIMEOUT_S=20.0
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------- #
#  STT  (speech to text)  - pick ONE or more; they are tried in order
# ---------------------------------------------------------------------------- #
# Sarvam is the best choice for Indian languages and is the default.
# https://dashboard.sarvam.ai  ->  API Keys
SARVAM_API_KEY=
# `saaras:v3` is the current speech-translate model. `saaras:v1` and
# `sarvam-2.5` from older docs are retired and return 404.
SARVAM_MODEL=saaras:v3
# translate = always returns English text (best for an English index)
# transcribe = returns the spoken language verbatim
SARVAM_MODE=translate
SARVAM_LANGUAGE=unknown

# ElevenLabs Scribe. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v2

# Groq also serves Whisper - if you set GROQ_API_KEY above you already have STT
# and need nothing else.
GROQ_STT_MODEL=whisper-large-v3-turbo

# Order to try providers in. Unconfigured ones are skipped automatically.
STT_PROVIDER=sarvam
STT_FALLBACK_ORDER=sarvam,groq,elevenlabs
STT_TIMEOUT_S=15.0

# ---------------------------------------------------------------------------- #
#  Dataset  (ai4bharat/MSMARCO-XI)
# ---------------------------------------------------------------------------- #
# Only needed if you hit hub rate limits. https://huggingface.co/settings/tokens
HF_TOKEN=

# Comma-separated language keys. Available:
#   asm ben brx guj hin kan mal mar ori pan tam tel urd eng
# `hin` (Hindi) is the default: it has both a train and a validation shard.
INGEST_LANGUAGES=hin

# validation (97,941 rows, 462 MB) or train (much larger). validation is plenty.
INGEST_SPLIT=validation

# How many source rows to pull. Each row carries ~8-10 candidate passages, so
# 1200 rows produces roughly 10k passages and 15-30k chunks per strategy.
# Ingest streams and stops early, so this directly controls build time
# (1200 rows ~= 2 min end to end including embedding).
INGEST_ROW_LIMIT=1200

# Index the Indic translations alongside the English passages. Costs ~2x index
# size and needs a multilingual embedder to be useful - see EMBED_MODEL below.
INGEST_INCLUDE_TRANSLATED=false

# ---------------------------------------------------------------------------- #
#  Embeddings
# ---------------------------------------------------------------------------- #
# Options (all 384-dim, so switching needs no index migration):
#   BAAI/bge-small-en-v1.5                       English, CLS pooling  (default)
#   intfloat/multilingual-e5-small               multilingual - use this if
#                                                INGEST_INCLUDE_TRANSLATED=true
#   sentence-transformers/all-MiniLM-L6-v2       fastest (~4.7 ms)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# 0 = auto (min(8, cores/2)). Measured optimum is 8 on a 16-thread CPU; more
# threads made a short-sequence forward pass *slower* than a single thread.
EMBED_THREADS=0

# ---------------------------------------------------------------------------- #
#  Retrieval
# ---------------------------------------------------------------------------- #
# memory  = NumPy exact dense matmul + rank_bm25       (~2-4 ms, lowest tail)
# lancedb = IVF_PQ/HNSW ANN + native BM25 FTS          (scales past RAM)
# both    = build both so /api/analytics can compare them head to head
RETRIEVAL_BACKEND=both

DEFAULT_STRATEGY=hierarchical
RETRIEVE_TOP_K=5
RETRIEVE_CANDIDATES=24

# rrf (reciprocal rank fusion, rank-based) or weighted (score-based)
FUSION_METHOD=rrf
# Dense weight when FUSION_METHOD=weighted. 1.0 = dense only, 0.0 = BM25 only.
HYBRID_ALPHA=0.65
RRF_K=60

# ---------------------------------------------------------------------------- #
#  Guardrails
# ---------------------------------------------------------------------------- #
# Post-generation: mean sentence-level grounding below this refuses the answer.
GROUNDING_THRESHOLD=0.65
# Pre-generation: best retrieval score below this means "not in the dataset".
CONTEXT_SUFFICIENCY_THRESHOLD=0.32

# ---------------------------------------------------------------------------- #
#  Benchmark
# ---------------------------------------------------------------------------- #
BENCHMARK_QUERIES=120
BENCHMARK_CONCURRENCY=4
BENCHMARK_WARMUP=5

# ---------------------------------------------------------------------------- #
#  Server
# ---------------------------------------------------------------------------- #
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Build any missing index at startup. Set false to require an explicit
# `python -m app.ingest` run.
AUTO_INDEX_ON_STARTUP=true
